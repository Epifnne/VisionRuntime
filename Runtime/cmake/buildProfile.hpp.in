#pragma once

#include <string_view>

namespace visionRuntime::config {

enum class CameraSdk {
None,
HikMvs
};

struct CameraCapabilities {
bool supportsHardwareTrigger;
bool supportsSdkBufferLease;
bool supportsUserBuffers;
};

struct NoCamera {};
struct HikMvsCamera {};

using SelectedCamera = @VISION_CAMERA_TYPE@;

struct BuildProfile {
static constexpr CameraSdk cameraSdk = @VISION_CAMERA_ENUM@;
static constexpr std::string_view cameraName = "@VISION_CAMERA_NAME@";
static constexpr CameraCapabilities cameraCapabilities{
@VISION_CAMERA_SUPPORTS_HARDWARE_TRIGGER@,
@VISION_CAMERA_SUPPORTS_SDK_BUFFER_LEASE@,
@VISION_CAMERA_SUPPORTS_USER_BUFFERS@
};
};

} // namespace visionRuntime::config