{
  "schemaVersion": {"major": 1, "minor": 0},
  "id": "anomalyHikMvsMulti", "name": "Multi-camera Anomaly Inspection",
  "runtimeProduct": "anomalyHikMvsMulti",
  "durationMilliseconds": 30000,
  "sources": [
    {"id": "camera0", "type": "camera", "ipAddress": "169.254.239.231", "pixelFormat": "gray8", "mode": "continuous"},
    {"id": "camera1", "type": "camera", "ipAddress": "169.254.239.232", "pixelFormat": "gray8", "mode": "continuous"}
  ],
  "model": {"packagePath": "model", "backendId": "openvino", "device": "CPU", "pluginDirectory": "plugins"},
  "pipeline": {
    "resizeShortSide": 256, "cropWidth": 224, "cropHeight": 224,
    "mean": [0.449], "standardDeviation": [0.226], "threshold": 2.0,
    "maxBatchSize": 2, "flushTimeoutMilliseconds": 20,
    "queueFullPolicy": "block", "faultPolicy": "stopSession"
  },
  "ui": {"pages": [{"id": "monitor", "title": "Multi-camera Inspection", "layout": "column", "children": [
    {"type": "row", "fillWidth": true, "fillHeight": true, "children": [
      {"type": "imageView", "endpoint": "stream.camera0", "fillWidth": true, "fillHeight": true},
      {"type": "imageView", "endpoint": "stream.camera1", "fillWidth": true, "fillHeight": true}
    ]},
    {"type": "stateCard", "endpoint": "inspection.result", "title": "Result"},
    {"type": "stateCard", "endpoint": "session.summary", "title": "Summary"},
    {"type": "row", "children": [
      {"type": "commandButton", "endpoint": "session.start", "label": "Start"},
      {"type": "commandButton", "endpoint": "session.stop", "label": "Stop"},
      {"type": "commandButton", "endpoint": "session.recover", "label": "Recover"}
    ]}
  ]}]}
}
