cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${TEST_DIRECTORY}")
file(READ "${PROFILE}" document)
string(JSON document SET "${document}" sources 0 directory "\"missing-offline-images\"")
string(JSON document SET "${document}" model
	"{\"packagePath\":\"missing-model\",\"backendId\":\"unavailable\",\"device\":\"CPU\",\"pluginDirectory\":\"missing-plugins\"}")
set(profile "${TEST_DIRECTORY}/offline-profile.json")
file(WRITE "${profile}" "${document}")
execute_process(COMMAND "${GENERATOR}" "${profile}" "${TEST_DIRECTORY}/generated.json"
	RESULT_VARIABLE described OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT described EQUAL 0)
	message(FATAL_ERROR "Offline generation initialized unavailable resources: ${output}${error}")
endif()
execute_process(COMMAND "${CLI}" "${profile}" --export-manifest "${TEST_DIRECTORY}/cli.json"
	RESULT_VARIABLE exported OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT exported EQUAL 0)
	message(FATAL_ERROR "CLI offline export failed: ${output}${error}")
endif()
file(READ "${TEST_DIRECTORY}/generated.json" generated)
file(READ "${TEST_DIRECTORY}/cli.json" cli)
if(NOT generated STREQUAL cli)
	message(FATAL_ERROR "Generator and CLI declarations differ")
endif()
string(JSON count LENGTH "${generated}" endpoints)
if(NOT count EQUAL 15)
	message(FATAL_ERROR "Unexpected endpoint count: ${count}")
endif()
execute_process(COMMAND "${CLI}" "${profile}"
	RESULT_VARIABLE run OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(run EQUAL 0)
	message(FATAL_ERROR "Normal execution unexpectedly accepted missing business resources")
endif()
message(STATUS "Offline exports succeeded; normal runtime correctly rejected missing resources")
