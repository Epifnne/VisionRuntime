if(NOT VISION_PRODUCT_SAMPLE MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*$")
	message(FATAL_ERROR "Invalid VISION_PRODUCT_SAMPLE")
endif()
set(VISION_SAMPLE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/../${VISION_PRODUCT_SAMPLE}")
get_filename_component(VISION_SAMPLE_DIRECTORY "${VISION_SAMPLE_DIRECTORY}" ABSOLUTE)
foreach(required shell.cmake sampleRuntime.hpp "${VISION_PRODUCT_SAMPLE}Sample.cpp")
	if(NOT EXISTS "${VISION_SAMPLE_DIRECTORY}/${required}")
		message(FATAL_ERROR "Sample '${VISION_PRODUCT_SAMPLE}' has no ${required}; provide an explicit runtime entry")
	endif()
endforeach()
include("${VISION_SAMPLE_DIRECTORY}/shell.cmake")
if(NOT VISION_SAMPLE_CAMERA STREQUAL "OPTIONAL")
	set(VISION_CAMERA_SDK "${VISION_SAMPLE_CAMERA}" CACHE STRING "Product camera SDK" FORCE)
endif()
set(VISION_SAMPLE_BACKEND "${VISION_SAMPLE_DEFAULT_BACKEND}" CACHE STRING "Product inference backend")
if(VISION_SAMPLE_BACKEND STREQUAL "openvino")
	set(VISION_BUILD_OPENVINO_PLUGIN ON CACHE BOOL "" FORCE)
	set(VISION_BUILD_TENSORRT_PLUGIN OFF CACHE BOOL "" FORCE)
	set(VISION_SAMPLE_DEVICE CPU)
elseif(VISION_SAMPLE_BACKEND STREQUAL "tensorrt")
	set(VISION_BUILD_TENSORRT_PLUGIN ON CACHE BOOL "" FORCE)
	set(VISION_BUILD_OPENVINO_PLUGIN OFF CACHE BOOL "" FORCE)
	set(VISION_SAMPLE_DEVICE 0)
else()
	message(FATAL_ERROR "Product backend must be openvino or tensorrt")
endif()
set(VISION_BUILD_SERVICE ON CACHE BOOL "" FORCE)
set(VISION_BUILD_SHELL ON CACHE BOOL "" FORCE)
set(VISION_BUILD_DESIGNER ON CACHE BOOL "" FORCE)
