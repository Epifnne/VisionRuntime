cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${TEST_DIRECTORY}/images" "${TEST_DIRECTORY}/package/artifacts"
	"${TEST_DIRECTORY}/plugins/fake")
file(WRITE "${TEST_DIRECTORY}/images/1.pgm" "P2\n2 2\n255\n20 20 20 20\n")
file(WRITE "${TEST_DIRECTORY}/images/2.pgm" "P2\n2 2\n255\n200 200 200 200\n")
file(COPY_FILE "${PLUGIN}" "${TEST_DIRECTORY}/plugins/fake/vision-backend-fake${SUFFIX}")
file(WRITE "${TEST_DIRECTORY}/package/artifacts/model.fake" "identity")
file(WRITE "${TEST_DIRECTORY}/package/manifest.json" [=[
{
  "schemaVersion":{"major":1,"minor":0},"id":"profile-test","version":"1.0.0",
  "inputs":[{"name":"images","elementType":"float32","layout":"nchw","shape":[1,1,1,1]}],
  "outputs":[{"name":"output","elementType":"float32","layout":"scalar","shape":[1]}],
  "artifacts":[{"id":"fake-cpu","backendId":"fake","kind":"identity","path":"artifacts/model.fake","devices":["CPU"]}]
}
]=])
file(READ "${PROFILE}" document)
if(MODE STREQUAL "cuda" OR MODE STREQUAL "cudaUnavailable")
	set(manifest "${TEST_DIRECTORY}/cuda.manifest.json")
	execute_process(COMMAND "${CLI}" "${PROFILE}" --export-manifest "${manifest}"
		RESULT_VARIABLE exported OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
	if(NOT exported STREQUAL "0")
		message(FATAL_ERROR "Offline CUDA declaration failed: ${output}${error}")
	endif()
	file(READ "${manifest}" declaration)
	if(NOT declaration MATCHES "measure.minimumBrightFraction" OR
		declaration MATCHES "measure.minimumBrightness" OR NOT declaration MATCHES "brightFraction")
		message(FATAL_ERROR "CUDA profile did not select its own measurement contract")
	endif()
	if(MODE STREQUAL "cudaUnavailable")
		execute_process(COMMAND "${CLI}" "${PROFILE}"
			RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
		if(NOT result MATCHES "^[1-9][0-9]*$" OR
			NOT "${output}${error}" MATCHES "requires VISION_WITH_OPENCV_CUDA=ON")
			message(FATAL_ERROR "CUDA mode must fail explicitly without GPU support: ${output}${error}")
		endif()
		return()
	endif()
endif()
string(JSON document SET "${document}" durationMilliseconds 0)
string(JSON sourceCount LENGTH "${document}" sources)
math(EXPR lastSource "${sourceCount} - 1")
foreach(index RANGE ${lastSource})
	string(JSON id GET "${document}" sources ${index} id)
	set(loop false)
	if(SAMPLE STREQUAL "eventInspection")
		set(loop true)
	endif()
	string(JSON document SET "${document}" sources ${index}
		"{\"id\":\"${id}\",\"type\":\"directory\",\"directory\":\"images\",\"extensions\":[\".pgm\"],\"loop\":${loop}}")
endforeach()
if(SAMPLE MATCHES "^anomaly")
	string(JSON document SET "${document}" model
		"{\"packagePath\":\"package\",\"backendId\":\"fake\",\"device\":\"CPU\",\"pluginDirectory\":\"plugins\"}")
	string(JSON document SET "${document}" pipeline
		"{\"resizeShortSide\":1,\"cropWidth\":1,\"cropHeight\":1,\"mean\":[0.0],\"standardDeviation\":[1.0],\"threshold\":1.0,\"maxBatchSize\":1,\"queueFullPolicy\":\"block\",\"faultPolicy\":\"stopSession\"}")
	if(MODE STREQUAL "batch")
		string(JSON document SET "${document}" pipeline maxBatchSize 2)
		string(JSON document SET "${document}" pipeline flushTimeoutMilliseconds 50)
	endif()
elseif(MODE STREQUAL "cuda")
	string(JSON document SET "${document}" cuda threshold 0)
	string(JSON document SET "${document}" cuda minimumBrightFraction 1)
elseif(SAMPLE STREQUAL "businessExports")
	string(JSON document SET "${document}" measurement minimumBrightness 210)
elseif(SAMPLE STREQUAL "yoloRouting")
	string(JSON document SET "${document}" routing annotationDirectory "\"annotations\"")
	string(JSON document SET "${document}" routing minimumConfidence 1.0)
elseif(SAMPLE STREQUAL "eventInspection")
	string(JSON document SET "${document}" inspection expectedTransitions 0)
endif()
set(profile "${TEST_DIRECTORY}/profile.json")
file(WRITE "${profile}" "${document}\n")
execute_process(COMMAND "${CLI}" "${profile}"
	WORKING_DIRECTORY "${TEST_DIRECTORY}/images"
	RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT result STREQUAL "0")
	message(FATAL_ERROR "${SAMPLE} profile replay failed (${result}): ${output}${error}")
endif()
if(MODE STREQUAL "cuda")
	if(NOT output MATCHES "\"brightFraction\":1" OR
		NOT output MATCHES "\"accepted\":true" OR output MATCHES "\"accepted\":false")
		message(FATAL_ERROR "Configured CUDA thresholds were not applied: ${output}")
	endif()
elseif(SAMPLE STREQUAL "businessExports")
	if(NOT output MATCHES "\"brightness\":200" OR output MATCHES "\"accepted\":true")
		message(FATAL_ERROR "Configured brightness threshold was not applied: ${output}")
	endif()
elseif(SAMPLE STREQUAL "yoloRouting")
	if(NOT output MATCHES "\"objects\":0" OR NOT output MATCHES "\"texts\":0")
		message(FATAL_ERROR "Configured detection confidence was not applied: ${output}")
	endif()
	file(GLOB annotations "${TEST_DIRECTORY}/annotations/*.png")
	list(LENGTH annotations count)
	if(NOT count EQUAL 2)
		message(FATAL_ERROR "Expected two annotation images, got ${count}")
	endif()
elseif(SAMPLE STREQUAL "eventInspection")
	if(NOT output MATCHES "\"okCount\":2" OR NOT output MATCHES "\"faultCount\":0")
		message(FATAL_ERROR "Event replay did not use configured directory/algorithms: ${output}")
	endif()
else()
	math(EXPR frames "2 * ${sourceCount}")
	if(NOT output MATCHES "completed=${frames} failed=0")
		message(FATAL_ERROR "Anomaly pipeline did not complete all configured sources: ${output}")
	endif()
endif()
set(validDocument "${document}")
string(JSON document SET "${document}" sources 0 directory "\"missing-images\"")
file(WRITE "${profile}" "${document}\n")
execute_process(COMMAND "${CLI}" "${profile}"
	RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
if(NOT result MATCHES "^[1-9][0-9]*$")
	message(FATAL_ERROR "${SAMPLE} did not explicitly reject a missing directory (${result}): ${output}${error}")
endif()
file(WRITE "${profile}" "${validDocument}\n")
if(MODE STREQUAL "cuda")
	string(JSON invalidDocument SET "${validDocument}" cuda device -1)
elseif(SAMPLE STREQUAL "yoloRouting")
	string(JSON invalidDocument SET "${validDocument}" routing minimumConfidence 1.5)
elseif(SAMPLE STREQUAL "businessExports")
	string(JSON invalidDocument SET "${validDocument}" measurement minimumBrightness -1)
elseif(SAMPLE STREQUAL "eventInspection")
	string(JSON invalidDocument SET "${validDocument}" inspection minimumBrightness -1)
else()
	string(JSON invalidDocument SET "${validDocument}" pipeline standardDeviation "[0.0]")
endif()
file(WRITE "${profile}" "${invalidDocument}\n")
execute_process(COMMAND "${CLI}" "${profile}"
	RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
if(NOT result MATCHES "^[1-9][0-9]*$")
	message(FATAL_ERROR "${SAMPLE} did not explicitly reject invalid algorithm parameters (${result}): ${output}${error}")
endif()
if(SAMPLE STREQUAL "businessExports")
	string(JSON invalidDocument SET "${validDocument}" measurement mode "\"unknown\"")
	file(WRITE "${profile}" "${invalidDocument}\n")
	execute_process(COMMAND "${CLI}" "${profile}"
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
	if(NOT result MATCHES "^[1-9][0-9]*$" OR
		NOT "${output}${error}" MATCHES "measurement.mode must be cpu or cuda")
		message(FATAL_ERROR "Unknown measurement mode was not explicitly rejected: ${output}${error}")
	endif()
endif()
file(WRITE "${profile}" "${validDocument}\n")
message(STATUS "${SAMPLE}: profile-relative replay, configured algorithms and explicit source errors passed")
