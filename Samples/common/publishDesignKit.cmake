cmake_minimum_required(VERSION 3.25)
file(RELATIVE_PATH relative "${PUBLISH_ROOT}" "${OUTPUT}")
if(NOT relative STREQUAL "release")
	message(FATAL_ERROR "Design kit replacement is restricted to Publish/release")
endif()
foreach(required "${SHELL_EXE}" "${DESIGNER_EXE}" "${PROFILE}")
	if(NOT EXISTS "${required}")
		message(FATAL_ERROR "Design kit input is missing: ${required}")
	endif()
endforeach()
if(EXISTS "${OUTPUT}")
	file(GLOB entries RELATIVE "${OUTPUT}" "${OUTPUT}/*")
	foreach(entry IN LISTS entries)
		if(NOT entry MATCHES "^(visionDesigner|runtimeTemplates|profiles|design\\.cmd|design\\.sh|sample-release\\.json)$")
			message(FATAL_ERROR "Refusing to replace release containing unrelated files: ${entry}")
		endif()
	endforeach()
endif()

get_filename_component(binaryDir "${SHELL_EXE}" DIRECTORY)
file(READ "${QML_DIR}/../Runtime/plugins/plugins.json" catalog)
string(JSON count LENGTH "${catalog}" backends)
set(selected "")
if(count GREATER 0)
	math(EXPR last "${count} - 1")
	foreach(index RANGE ${last})
		string(JSON id GET "${catalog}" backends ${index} id)
		if(id STREQUAL BACKEND)
			string(JSON selected GET "${catalog}" backends ${index})
		endif()
	endforeach()
endif()
if(selected STREQUAL "")
	message(FATAL_ERROR "Selected backend is absent from the capability manifest: ${BACKEND}")
endif()
string(JSON pluginName GET "${selected}" pluginLibrary "${PLATFORM}")
if(NOT EXISTS "${binaryDir}/plugins/${BACKEND}/${pluginName}")
	message(FATAL_ERROR "Selected backend runtime is missing: ${BACKEND}/${pluginName}")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef token)
set(stage "${OUTPUT}.staging-${token}")
set(backup "${OUTPUT}.previous-${token}")
set(runtime "${stage}/runtimeTemplates/${PLATFORM}")
set(designer "${stage}/visionDesigner")
file(MAKE_DIRECTORY "${runtime}/plugins" "${designer}" "${stage}/profiles")
file(COPY "${SHELL_EXE}" DESTINATION "${runtime}")
file(COPY "${DESIGNER_EXE}" DESTINATION "${designer}")
file(COPY "${binaryDir}/plugins/${BACKEND}" DESTINATION "${runtime}/plugins")
file(WRITE "${runtime}/plugins/plugins.json"
	"{\"schemaVersion\":{\"major\":1,\"minor\":0},\"backends\":[${selected}]}\n")
file(COPY_FILE "${binaryDir}/runtime-version.json" "${runtime}/runtime-version.json")
file(COPY_FILE "${PROFILE}" "${stage}/profiles/${SAMPLE}.json")
file(COPY "${QML_DIR}/controls" DESTINATION "${designer}/Shell")
if(PLATFORM STREQUAL "windows")
	if(NOT CAMERA_RUNTIME STREQUAL "")
		file(GLOB cameraLibraries "${CAMERA_RUNTIME}/*.dll")
		if(NOT cameraLibraries)
			message(FATAL_ERROR "Selected camera SDK runtime is missing")
		endif()
		file(COPY ${cameraLibraries} DESTINATION "${runtime}")
	endif()
	foreach(component runtime designer)
		if(component STREQUAL "runtime")
			set(executable "${runtime}/visionShell.exe")
			set(qml "${QML_DIR}")
		else()
			set(executable "${designer}/visionDesigner.exe")
			set(qml "${DESIGNER_QML_DIR}")
		endif()
		execute_process(COMMAND "${WINDEPLOYQT}" --release --dir "${${component}}"
			--qmldir "${qml}" --compiler-runtime --no-translations
			--skip-plugin-types qmltooling,generic,qmllint,qmlls "${executable}"
			RESULT_VARIABLE deployed)
		if(NOT deployed EQUAL 0)
			message(FATAL_ERROR "Qt deployment failed for ${component} (${deployed}); existing release is unchanged")
		endif()
	endforeach()
	file(WRITE "${stage}/design.cmd"
		"@echo off\r\ncd /d \"%~dp0\"\r\nstart \"\" \"visionDesigner\\visionDesigner.exe\" \"profiles\\${SAMPLE}.json\"\r\n")
else()
	file(WRITE "${stage}/design.sh"
		"#!/bin/sh\nset -eu\ncd -- \"$(dirname -- \"$0\")\"\nexec ./visionDesigner/visionDesigner \"profiles/${SAMPLE}.json\"\n")
	file(CHMOD "${stage}/design.sh" PERMISSIONS
		OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endif()
file(WRITE "${stage}/sample-release.json"
	"{\"sample\":\"${SAMPLE}\",\"platform\":\"${PLATFORM}\",\"backend\":\"${BACKEND}\",\"kind\":\"designKit\"}\n")
if(EXISTS "${OUTPUT}")
	file(RENAME "${OUTPUT}" "${backup}" RESULT moved)
	if(NOT moved STREQUAL "0")
		message(FATAL_ERROR "Cannot replace current release (${moved}); close Designer and Shell and retry")
	endif()
endif()
file(RENAME "${stage}" "${OUTPUT}" RESULT installed)
if(NOT installed STREQUAL "0")
	if(EXISTS "${backup}")
		file(RENAME "${backup}" "${OUTPUT}")
	endif()
	message(FATAL_ERROR "Cannot install design kit: ${installed}")
endif()
if(EXISTS "${backup}")
	file(REMOVE_RECURSE "${backup}")
endif()
message(STATUS "Published design kit for ${SAMPLE}: ${OUTPUT}")
