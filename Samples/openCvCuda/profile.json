{
  "schemaVersion": {"major": 1, "minor": 0},
  "id": "openCvCuda", "name": "OpenCV CUDA Inspection", "runtimeProduct": "openCvCuda",
  "sources": [
    {"id": "files", "type": "directory", "directory": "../businessExports/images",
     "extensions": [".pgm"], "loop": false}
  ],
  "cuda": {"device": 0, "threshold": 127, "minimumBrightFraction": 0.5},
  "pipeline": {"queueFullPolicy": "block", "faultPolicy": "stopSession"},
  "ui": {"pages": [{"id": "monitor", "title": "CUDA Inspection", "layout": "column", "children": [
    {"type": "imageView", "endpoint": "stream.files", "fillWidth": true, "fillHeight": true},
    {"type": "statNumber", "endpoint": "cuda.result", "field": "brightFraction"},
    {"type": "stateCard", "endpoint": "cuda.result", "title": "GPU Result (No CPU Fallback)"},
    {"type": "row", "children": [
      {"type": "commandButton", "endpoint": "session.start", "label": "Start"},
      {"type": "commandButton", "endpoint": "session.stop", "label": "Stop"},
      {"type": "commandButton", "endpoint": "session.recover", "label": "Recover"}
    ]}
  ]}]}
}
